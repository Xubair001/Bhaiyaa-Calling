<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Names instead of bare numbers, and the contact list itself. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Real call history for Calls, Insights and the assistant's answers. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Detect that a call is ringing so a VIP alert can fire in time. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- VIP vibration patterns. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+ runtime permission for any notification at all. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Lets a VIP tier's channel ring through Do Not Disturb / silent mode.
      This is NOT granted by a normal permission prompt: the user must allow
      it explicitly in system settings, and BHAIYAAA sends them there rather
      than trying to work around it.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Requested only when the user taps the mic in Assistant, never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Re-arm reminder alarms after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Model downloads in the Model Manager are user-initiated only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Note: torch control via CameraManager.setTorchMode() does NOT require the
      CAMERA permission, so BHAIYAAA deliberately does not ask for it.
    -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
      Package visibility (Android 11+). BHAIYAAA hands numbers off to the phone's
      own dialer and messaging app rather than dialling itself, so those intents
      must be declared to be resolvable.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:name=".BhaiyaaaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Bhaiyaaa"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Bhaiyaaa.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          PHONE_STATE is a protected broadcast: this is the same mechanism
          caller-ID and call-blocker apps use, and it needs neither the default
          dialer nor the call-screening role.
        -->
        <receiver
            android:name=".service.IncomingCallReceiver"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.ReminderAlarmReceiver"
            android:exported="false" />

        <!--
          BhaiyaaaApplication implements Configuration.Provider, i.e. WorkManager
          is initialised on demand. The library still merges its own
          WorkManagerInitializer into the manifest, which would initialise
          WorkManager first and silently discard that configuration - so the
          default initializer is removed here.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
