<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Only the window background and splash live here. Everything else is a
      Compose token in ui/theme/Color.kt - these exist so the frame drawn before
      Compose composes is already the right colour rather than a white flash.
    -->
    <color name="brand_violet">#6A3FBF</color>
    <color name="splash_background">#1A1230</color>
    <color name="window_background_light">#FDF7FF</color>
    <color name="window_background_dark">#121016</color>
    <color name="ic_launcher_background">#1A1230</color>

    <!--
      Accent for notifications. The system tints the small icon and the app
      name with this, and it is the one piece of the app's palette that has to
      be a platform colour rather than a Compose token - a notification is
      drawn by system_ui, which cannot see MaterialTheme. Matched to the
      violet primary so the shade looks like the app it came from.
    -->
    <color name="notification_accent">#6A3FBF</color>
</resources>
