    <!-- Onboarding -->
    <string name="onboarding_1_title">Sukoon</string>
    <string name="onboarding_1_body">The people who matter get through. Everything else waits.</string>
    <string name="onboarding_2_title">Your private call companion</string>
    <string name="onboarding_2_body">Sukoon keeps track of who matters, what they said, and what you promised to do.</string>
    <string name="onboarding_3_title">VIP callers get VIP treatment</string>
    <string name="onboarding_3_body">Mark someone VIP and their call gets its own vibration, flashlight pattern and heads-up alert.</string>
    <string name="onboarding_4_title">Your data stays on your phone</string>
    <string name="onboarding_4_body">No cloud, no account, no API key. Everything is stored locally and encrypted where it counts.</string>
    <string name="onboarding_5_title">Let\'s set up your Sukoon</string>
    <string name="onboarding_5_body">We\'ll ask for a few permissions. Each one is explained, and you can say no to any of them.</string>
