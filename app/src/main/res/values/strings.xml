    <!-- Permissions -->
    <string name="perm_contacts_title">Contacts</string>
    <string name="perm_contacts_why">So Sukoon can show names instead of bare numbers, and let you tag people.</string>
    <string name="perm_call_log_title">Call log</string>
    <string name="perm_call_log_why">So your call history, insights and \"who called me\" answers use your real calls.</string>
    <string name="perm_phone_state_title">Phone state</string>
    <string name="perm_phone_state_why">So Sukoon can spot a VIP the moment their call starts ringing.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_why">So VIP alerts can actually reach you.</string>
    <string name="perm_mic_title">Microphone</string>
    <string name="perm_mic_why">Only used while you hold the mic button in Assistant. Nothing is recorded or uploaded.</string>
